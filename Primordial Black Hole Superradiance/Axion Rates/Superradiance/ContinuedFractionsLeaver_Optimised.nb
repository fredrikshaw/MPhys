Notebook[{Cell["Continued Fractions \[LongDash] Optimised", "Title"], 
  Cell["Independent optimised copy of ContinuedFractionsLeaver.nb. The \
original is unchanged. Evaluate the initialization cells, then the parameter \
and run cells below. The notebook is self-contained and uses \
arbitrary-precision Mathematica arithmetic.", "Text"], 
  Cell["Changes and accuracy controls", "Section"], 
  Cell["The solver evaluates the complex continued fraction once per trial \
and returns both real residual components. It precomputes fixed indices and \
Kerr factors, constructs coefficient lists directly, and uses a local \
one-entry trial cache. The original recurrence coefficients, terminal \
condition and Gamma = 2 Im[omega] convention are preserved. Precision \
controls inside the backward sweep are retained.", "Text"], 
  Cell["Adaptive depth doubles the truncation until neighbouring depths agree \
in Im[omega] to RateTolerance (default 10^-4), with a separate real-frequency \
check. The accepted solution is repeated with 15 extra digits. A depth or \
precision failure is reported as Failed rather than accepted as a converged \
rate. The common binding scale is used for both frequency coordinates; the \
tiny rate is resolved through working precision and checked separately.", 
   "Text"], Cell["The ten positional PlotSuperradiance arguments are \
retained. In this copy, Nmax sets the adaptive depth budget; the original \
small-alpha safeguard Max[Nmax, Ceiling[30/alpha]] still applies. Set \
\"MaxDepth\" explicitly to override that budget. Small alpha can require tens \
of thousands of terms. Set \"AdaptiveDepth\" -> False for a fixed-depth \
comparison. \"RateTolerance\", \"PrecisionCheck\", \"ScaledVariables\", \
\"MinDepth\", \"ContinuityFactor\", \"TimeLimit\" and \"Verbose\" are \
configurable options.", "Text"], Cell["Continuation predicts from the actual \
successful alpha coordinates, including after gaps. The existing factor-three \
growth-rate continuity guard is retained outside the small-alpha fallback \
region and can be adjusted with ContinuityFactor. As in the original, n \
selects an initial seed, so overtone identity still requires sensible seeds \
and continuous branch tracking. This remains a growing-mode solver (not a \
signed decay-rate survey); use 0 <= spin < 1. Exact extremality needs a \
different recurrence.", "Text"], Cell["Outputs are written to an Optimised \
Data subfolder beside this notebook, with unique filenames. The .dat file \
retains alpha, CF_Gamma, Hydro_Gamma. A companion diagnostics TSV records \
status, complex frequency, depth, precision, convergence change and time. \
Unattempted grid points are marked separately in diagnostics. OutputDirectory \
can select another folder. Plain TSV writing preserves small rates without \
relying on Mathematica's general Export framework.", "Text"], 
  Cell["Solver initialization", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], 
      ";"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{RowBox[{"G", "=", "1"}], ";", RowBox[{"M", "=", "1"}], 
      ";", RowBox[{"prec", "=", "50"}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{RowBox[{"$SRLastSolve", "=", 
        RowBox[{"Association", "[", "]"}]}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[{RowBox[{"$SRLastRun", "=", 
        RowBox[{"Association", "[", "]"}]}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"SRNumber", "[", RowBox[{"x_", ",", "p_Integer"}], 
          "]"}], ":=", RowBox[{"N", "[", RowBox[
           {RowBox[{"Rationalize", "[", RowBox[{"x", ",", "0"}], "]"}], ",", 
            "p"}], "]"}]}], ";"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"AdaptivePrec", "[", RowBox[{"l_", ",", "alpha_", ",", 
            RowBox[{"previous_", ":", "Null"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"scaling", ",", 
                "history"}], "}"}], ",", RowBox[{RowBox[{"scaling", "=", 
                RowBox[{RowBox[{"Ceiling", "[", RowBox[{RowBox[{"(", 
                        RowBox[{RowBox[{"4", " ", "l"}], "+", "5"}], ")"}], 
                      " ", RowBox[{"Max", "[", RowBox[{"0", ",", RowBox[
                          {"-", RowBox[{"Log10", "[", RowBox[{"Abs", "[", 
                          "alpha", "]"}], "]"}]}]}], "]"}]}], "]"}], "+", 
                  "30"}]}], ";", RowBox[{"history", "=", RowBox[{"If", "[", 
                  RowBox[{RowBox[{RowBox[{"NumericQ", "[", "previous", "]"}], 
                      "&&", RowBox[{"previous", "\[NotEqual]", "0"}]}], ",", 
                    RowBox[{RowBox[{"Ceiling", "[", RowBox[{"Max", "[", 
                          RowBox[{"0", ",", RowBox[{"-", RowBox[{"Log10", 
                          "[", RowBox[{"Abs", "[", "previous", "]"}], 
                          "]"}]}]}], "]"}], "]"}], "+", "30"}], ",", "0"}], 
                  "]"}]}], ";", RowBox[{"Max", "[", RowBox[{"40", ",", 
                  "scaling", ",", "history"}], "]"}]}]}], "]"}]}], ";"}]], 
   "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"AdaptiveNmax", "[", RowBox[{"l_", ",", "alpha_", ",", 
            "base_"}], "]"}], ":=", RowBox[{"Max", "[", 
          RowBox[{"base", ",", RowBox[{"Ceiling", "[", FractionBox["30", 
               "alpha"], "]"}]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"AngularLambda", "[", RowBox[{"omega_", ",", "at_", 
            ",", "l_", ",", "m_", ",", "alpha_"}], "]"}], ":=", 
        RowBox[{"N", "[", RowBox[{RowBox[{"SpheroidalEigenvalue", "[", 
              RowBox[{"l", ",", "m", ",", RowBox[{"\[ImaginaryI]", " ", "at", 
                  " ", SqrtBox[RowBox[{SuperscriptBox["omega", "2"], "-", 
                     SuperscriptBox["alpha", "2"]}]]}]}], "]"}], ",", 
            "prec"}], "]"}]}], ";"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"HydrogenGamma", "[", RowBox[{"n_", ",", "l_", ",", 
            "m_", ",", "alpha_", ",", "at_"}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"rp", ",", "oh", 
                ",", "cnl", ",", "glm"}], "}"}], ",", 
            RowBox[{RowBox[{"rp", "=", RowBox[{"1", "+", SqrtBox[RowBox[
                    {"1", "-", SuperscriptBox["at", "2"]}]]}]}], ";", 
              RowBox[{"oh", "=", FractionBox["at", RowBox[{"2", " ", 
                   "rp"}]]}], ";", RowBox[{"cnl", "=", FractionBox[
                 RowBox[{SuperscriptBox["2", RowBox[{RowBox[{"4", " ", "l"}], 
                      "+", "1"}]], " ", RowBox[{RowBox[{"(", RowBox[{"n", 
                         "+", "l"}], ")"}], "!"}], " ", SuperscriptBox[
                    RowBox[{"(", FractionBox[RowBox[{"l", "!"}], RowBox[
                        {RowBox[{RowBox[{"(", RowBox[{"2", " ", "l"}], ")"}], 
                          "!"}], " ", RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {"2", " ", "l"}], "+", "1"}], ")"}], "!"}]}]], 
                      ")"}], "2"]}], RowBox[{SuperscriptBox["n", RowBox[
                     {RowBox[{"2", " ", "l"}], "+", "4"}]], " ", RowBox[
                    {RowBox[{"(", RowBox[{"n", "-", "l", "-", "1"}], ")"}], 
                     "!"}]}]]}], ";", RowBox[{"glm", "=", RowBox[{"If", "[", 
                  RowBox[{RowBox[{"l", "\[Equal]", "0"}], ",", "1", ",", 
                    RowBox[{UnderoverscriptBox["\[Product]", RowBox[{"k", 
                         "=", "1"}], "l"], RowBox[{"(", RowBox[{RowBox[
                          {SuperscriptBox["k", "2"], " ", RowBox[{"(", 
                          RowBox[{"1", "-", SuperscriptBox["at", "2"]}], 
                          ")"}]}], "+", SuperscriptBox[RowBox[{"(", RowBox[
                          {RowBox[{"at", " ", "m"}], "-", RowBox[{"2", " ", 
                          "rp", " ", "alpha"}]}], ")"}], "2"]}], ")"}]}]}], 
                  "]"}]}], ";", RowBox[{"2", " ", "rp", " ", "cnl", " ", 
                "glm", " ", RowBox[{"(", RowBox[{RowBox[{"m", " ", "oh"}], 
                    "-", "alpha"}], ")"}], " ", SuperscriptBox["alpha", 
                 RowBox[{RowBox[{"4", " ", "l"}], "+", "5"}]]}]}]}], "]"}]}], 
      ";"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"SRMakeCF", "[", RowBox[{"at0_", ",", "m_Integer", ",", 
            "l_Integer", ",", "alpha0_", ",", "depth_Integer", ",", 
            "wp_Integer"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"at", "=", RowBox[{"SRNumber", 
                    "[", RowBox[{"at0", ",", "wp"}], "]"}]}], ",", 
                RowBox[{"alpha", "=", RowBox[{"SRNumber", "[", RowBox[
                     {"alpha0", ",", "wp"}], "]"}]}], ",", "b", ",", 
                RowBox[{"idx", "=", RowBox[{"Range", "[", RowBox[{"0", ",", 
                      RowBox[{"depth", "+", "1"}]}], "]"}]}], ",", "idx2", 
                ",", "twiOverB"}], "}"}], ",", RowBox[
             {RowBox[{"b", "=", SqrtBox[RowBox[{"1", "-", SuperscriptBox[
                    "at", "2"]}]]}], ";", RowBox[{"idx2", "=", SuperscriptBox[
                 "idx", "2"]}], ";", RowBox[{"twiOverB", "=", FractionBox[
                 RowBox[{"2", " ", "\[ImaginaryI]"}], "b"]}], ";", 
              RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"wr", 
                      ",", "wi"}], "}"}], ",", RowBox[{"Module", "[", 
                    RowBox[{RowBox[{"{", RowBox[{"omega", ",", "q", ",", 
                          "iq", ",", "d", ",", "d2", ",", "t", ",", "lambda", 
                          ",", "c0", ",", "c1", ",", "c2", ",", "c3", ",", 
                          "c4", ",", "aa", ",", "bb", ",", "gg", ",", "r", 
                          ",", "j"}], "}"}], ",", RowBox[{RowBox[{"omega", 
                          "=", RowBox[{"wr", "+", RowBox[{"\[ImaginaryI]", 
                          " ", "wi"}]}]}], ";", RowBox[{"q", "=", RowBox[
                          {"-", SqrtBox[RowBox[{SuperscriptBox["alpha", "2"], 
                          "-", SuperscriptBox["omega", "2"]}]]}]}], ";", 
                        RowBox[{"iq", "=", FractionBox["1", "q"]}], ";", 
                        RowBox[{"d", "=", RowBox[{"omega", "-", RowBox[
                          {"\[ImaginaryI]", " ", "q"}]}]}], ";", RowBox[
                         {"d2", "=", SuperscriptBox["d", "2"]}], ";", 
                        RowBox[{"t", "=", RowBox[{"omega", "-", FractionBox[
                          RowBox[{"at", " ", "m"}], "2"]}]}], ";", RowBox[
                         {"lambda", "=", RowBox[{"N", "[", RowBox[{RowBox[
                          {"SpheroidalEigenvalue", "[", RowBox[{"l", ",", 
                          "m", ",", RowBox[{"\[ImaginaryI]", " ", "at", " ", 
                          SqrtBox[RowBox[{SuperscriptBox["omega", "2"], "-", 
                          SuperscriptBox["alpha", "2"]}]]}]}], "]"}], ",", 
                          "wp"}], "]"}]}], ";", RowBox[{"c0", "=", RowBox[
                          {"1", "-", RowBox[{"2", " ", "\[ImaginaryI]", " ", 
                          "omega"}], "-", RowBox[{"twiOverB", " ", "t"}]}]}], 
                        ";", RowBox[{"c1", "=", RowBox[{RowBox[{"-", "4"}], 
                          "+", RowBox[{"4", " ", "\[ImaginaryI]", " ", 
                          RowBox[{"(", RowBox[{"omega", "-", RowBox[
                          {"\[ImaginaryI]", " ", "q", " ", RowBox[{"(", 
                          RowBox[{"1", "+", "b"}], ")"}]}]}], ")"}]}], "+", 
                          RowBox[{"2", " ", "twiOverB", " ", "t"}], "-", 
                          RowBox[{"2", " ", RowBox[{"(", RowBox[
                          {SuperscriptBox["omega", "2"], "+", SuperscriptBox[
                          "q", "2"]}], ")"}], " ", "iq"}]}]}], ";", RowBox[
                         {"c2", "=", RowBox[{"3", "-", RowBox[{"2", " ", 
                          "\[ImaginaryI]", " ", "omega"}], "-", RowBox[
                          {"2", " ", RowBox[{"(", RowBox[{SuperscriptBox["q", 
                          "2"], "-", SuperscriptBox["omega", "2"]}], ")"}], 
                          " ", "iq"}], "-", RowBox[{"twiOverB", " ", 
                          "t"}]}]}], ";", RowBox[{"c3", "=", RowBox[
                          {RowBox[{"2", " ", "\[ImaginaryI]", " ", "d2", " ", 
                          "d", " ", "iq"}], "+", RowBox[{"2", " ", "d2", " ", 
                          "b"}], "+", RowBox[{SuperscriptBox["q", "2"], " ", 
                          SuperscriptBox["at", "2"]}], "+", RowBox[{"2", " ", 
                          "\[ImaginaryI]", " ", "q", " ", "at", " ", "m"}], 
                          "-", "lambda", "-", "1", "-", RowBox[{"d2", " ", 
                          "iq"}], "+", RowBox[{"2", " ", "q", " ", "b"}], 
                          "+", RowBox[{"twiOverB", " ", RowBox[{"(", RowBox[
                          {RowBox[{"d2", " ", "iq"}], "+", "1"}], ")"}], " ", 
                          "t"}]}]}], ";", RowBox[{"c4", "=", RowBox[
                          {RowBox[{SuperscriptBox["d2", "2"], " ", 
                          SuperscriptBox["iq", "2"]}], "+", RowBox[{"2", " ", 
                          "\[ImaginaryI]", " ", "omega", " ", "d2", " ", 
                          "iq"}], "-", RowBox[{"twiOverB", " ", "d2", " ", 
                          "iq", " ", "t"}]}]}], ";", RowBox[{"aa", "=", 
                          RowBox[{"SetPrecision", "[", RowBox[{RowBox[
                          {"idx2", "+", RowBox[{RowBox[{"(", RowBox[{"c0", 
                          "+", "1"}], ")"}], " ", "idx"}], "+", "c0"}], ",", 
                          "wp"}], "]"}]}], ";", RowBox[{"bb", "=", RowBox[
                          {"SetPrecision", "[", RowBox[{RowBox[{RowBox[
                          {RowBox[{"-", "2"}], " ", "idx2"}], "+", RowBox[
                          {RowBox[{"(", RowBox[{"c1", "+", "2"}], ")"}], " ", 
                          "idx"}], "+", "c3"}], ",", "wp"}], "]"}]}], ";", 
                        RowBox[{"gg", "=", RowBox[{"SetPrecision", "[", 
                          RowBox[{RowBox[{"idx2", "+", RowBox[{RowBox[{"(", 
                          RowBox[{"c2", "-", "3"}], ")"}], " ", "idx"}], "+", 
                          "c4"}], ",", "wp"}], "]"}]}], ";", RowBox[{"r", 
                          "=", RowBox[{"SetPrecision", "[", RowBox[{RowBox[
                          {"-", FractionBox[RowBox[{"gg", 
                          "\[LeftDoubleBracket]", RowBox[{"depth", "+", 
                          "1"}], "\[RightDoubleBracket]"}], RowBox[{"aa", 
                          "\[LeftDoubleBracket]", RowBox[{"depth", "+", 
                          "1"}], "\[RightDoubleBracket]"}]]}], ",", "wp"}], 
                          "]"}]}], ";", RowBox[{"Do", "[", RowBox[{RowBox[
                          {"r", "=", RowBox[{"SetPrecision", "[", RowBox[
                          {RowBox[{RowBox[{"bb", "\[LeftDoubleBracket]", 
                          RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], 
                          "-", FractionBox[RowBox[{RowBox[{"aa", 
                          "\[LeftDoubleBracket]", RowBox[{"j", "+", "1"}], 
                          "\[RightDoubleBracket]"}], " ", RowBox[{"gg", 
                          "\[LeftDoubleBracket]", RowBox[{"j", "+", "2"}], 
                          "\[RightDoubleBracket]"}]}], "r"]}], ",", "wp"}], 
                          "]"}]}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[
                          {"depth", "-", "1"}], ",", "1", ",", RowBox[{"-", 
                          "1"}]}], "}"}]}], "]"}], ";", RowBox[{RowBox[
                          {"bb", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], "-", FractionBox[RowBox[
                          {RowBox[{"aa", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], " ", RowBox[{"gg", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}]}], "r"]}]}]}], "]"}]}], 
                "]"}]}]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"LeaverCF", "[", RowBox[
           {RowBox[{"wr_", "?", "NumericQ"}], ",", RowBox[{"wi_", "?", 
              "NumericQ"}], ",", "at_", ",", "m_Integer", ",", "l_Integer", 
            ",", "alpha_", ",", RowBox[{"depth_Integer", ":", "400"}]}], 
          "]"}], ":=", RowBox[{RowBox[{"SRMakeCF", "[", 
            RowBox[{"at", ",", "m", ",", "l", ",", "alpha", ",", "depth", 
              ",", "prec"}], "]"}], "[", RowBox[
           {RowBox[{"SRNumber", "[", RowBox[{"wr", ",", "prec"}], "]"}], ",", 
            RowBox[{"SRNumber", "[", RowBox[{"wi", ",", "prec"}], "]"}]}], 
          "]"}]}], ";"}]], "Input", InitializationCell -> True], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"SRFiniteQ", "[", "z_", "]"}], ":=", 
        RowBox[{RowBox[{"NumericQ", "[", "z", "]"}], "&&", 
          RowBox[{"FreeQ", "[", RowBox[{"z", ",", RowBox[{"Indeterminate", 
                "|", "_DirectedInfinity"}]}], "]"}]}]}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"SRRelativeIm", "[", RowBox[{"a_", ",", "b_"}], "]"}], 
        ":=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Max", "[", 
                RowBox[{RowBox[{"Abs", "[", RowBox[{"Im", "[", "a", "]"}], 
                    "]"}], ",", RowBox[{"Abs", "[", RowBox[{"Im", "[", "b", 
                      "]"}], "]"}]}], "]"}], "\[Equal]", "0"}], ",", 
            "\[Infinity]", ",", FractionBox[RowBox[{"Abs", "[", RowBox[
                {RowBox[{"Im", "[", "a", "]"}], "-", RowBox[{"Im", "[", "b", 
                   "]"}]}], "]"}], RowBox[{"Max", "[", RowBox[
                {RowBox[{"Abs", "[", RowBox[{"Im", "[", "a", "]"}], "]"}], 
                 ",", RowBox[{"Abs", "[", RowBox[{"Im", "[", "b", "]"}], 
                   "]"}]}], "]"}]]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> True], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"SRRootAtDepth", "[", RowBox[{"n_", ",", "l_", ",", 
            "m_", ",", "alpha0_", ",", "at0_", ",", "seed_", ",", "depth_", 
            ",", "wp_", ",", "scaled_", ",", "limit_"}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"alpha", "=", RowBox[{"SRNumber", 
                    "[", RowBox[{"alpha0", ",", "wp"}], "]"}]}], ",", 
                RowBox[{"at", "=", RowBox[{"SRNumber", "[", RowBox[{"at0", 
                      ",", "wp"}], "]"}]}], ",", "cf", ",", "center", ",", 
                "reScale", ",", "imScale", ",", "rateScale", ",", "seed0", 
                ",", "x", ",", "y", ",", "residual", ",", RowBox[{"lastXY", 
                  "=", "Null"}], ",", "lastValue", ",", RowBox[{"calls", "=", 
                  "0"}], ",", "sol", ",", "omega", ",", "value", ",", 
                "seconds", ",", RowBox[{"goal", "=", RowBox[{"wp", "-", 
                    "15"}]}], ",", "start", ",", "scaledError"}], "}"}], ",", 
            RowBox[{RowBox[{"start", "=", RowBox[{"AbsoluteTime", "[", 
                  "]"}]}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{RowBox[{"!", RowBox[{"TrueQ", "[", RowBox[
                         {RowBox[{"alpha", ">", "0"}], "&&", RowBox[{"0", 
                          "\[LessEqual]", "at", "<", "1"}]}], "]"}]}], "||", 
                    RowBox[{"n", "\[LessEqual]", "l"}], "||", RowBox[
                     {"l", "<", RowBox[{"Abs", "[", "m", "]"}]}]}], ",", 
                  RowBox[{"Return", "[", RowBox[{"Association", "[", 
                      RowBox[{"\"Status\"", "\[Rule]", 
                        "\"InvalidParameters\""}], "]"}], "]"}]}], "]"}], 
              ";", RowBox[{"seed0", "=", RowBox[{RowBox[{"SRNumber", "[", 
                    RowBox[{RowBox[{"Re", "[", "seed", "]"}], ",", "wp"}], 
                    "]"}], "+", RowBox[{"\[ImaginaryI]", " ", RowBox[
                     {"SRNumber", "[", RowBox[{RowBox[{"Im", "[", "seed", 
                          "]"}], ",", "wp"}], "]"}]}]}]}], ";", 
              RowBox[{"center", "=", RowBox[{"If", "[", RowBox[
                   {RowBox[{"TrueQ", "[", "scaled", "]"}], ",", "alpha", ",", 
                    "0"}], "]"}]}], ";", RowBox[{"reScale", "=", 
                RowBox[{"If", "[", RowBox[{RowBox[{"TrueQ", "[", "scaled", 
                      "]"}], ",", FractionBox[SuperscriptBox["alpha", "3"], 
                     RowBox[{"2", " ", SuperscriptBox["n", "2"]}]], ",", 
                    "1"}], "]"}]}], ";", RowBox[{"imScale", "=", "reScale"}], 
              ";", RowBox[{"rateScale", "=", RowBox[{"Max", "[", 
                  RowBox[{RowBox[{"Abs", "[", RowBox[{"Im", "[", "seed0", 
                        "]"}], "]"}], ",", RowBox[{"Abs", "[", RowBox[
                       {"HydrogenGamma", "[", RowBox[{"n", ",", "l", ",", 
                          "m", ",", "alpha", ",", "at"}], "]"}], "]"}], ",", 
                    SuperscriptBox["10", RowBox[{RowBox[{"-", "wp"}], "+", 
                       "20"}]]}], "]"}]}], ";", RowBox[{"cf", "=", 
                RowBox[{"SRMakeCF", "[", RowBox[{"at", ",", "m", ",", "l", 
                    ",", "alpha", ",", "depth", ",", "wp"}], "]"}]}], ";", 
              RowBox[{RowBox[{"residual", "[", RowBox[{RowBox[{"u_", "?", 
                      "NumericQ"}], ",", RowBox[{"v_", "?", "NumericQ"}]}], 
                  "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"lastXY", 
                      "===", RowBox[{"{", RowBox[{"u", ",", "v"}], "}"}]}], 
                    ",", "lastValue", ",", RowBox[{RowBox[{"lastXY", "=", 
                        RowBox[{"{", RowBox[{"u", ",", "v"}], "}"}]}], ";", 
                      RowBox[{"calls", "++"}], ";", RowBox[{"With", "[", 
                        RowBox[{RowBox[{"{", RowBox[{"z", "=", RowBox[{"cf", 
                          "[", RowBox[{RowBox[{"center", "+", RowBox[
                          {"reScale", " ", "u"}]}], ",", RowBox[{"imScale", 
                          " ", "v"}]}], "]"}]}], "}"}], ",", RowBox[
                          {"lastValue", "=", RowBox[{"{", RowBox[{RowBox[
                          {"Re", "[", "z", "]"}], ",", RowBox[{"Im", "[", 
                          "z", "]"}]}], "}"}]}]}], "]"}]}]}], "]"}]}], ";", 
              RowBox[{"sol", "=", RowBox[{"TimeConstrained", "[", 
                  RowBox[{RowBox[{"Quiet", "[", RowBox[{"FindRoot", "[", 
                        RowBox[{RowBox[{"residual", "[", RowBox[{"x", ",", 
                          "y"}], "]"}], ",", RowBox[{"{", RowBox[{RowBox[
                          {"{", RowBox[{"x", ",", FractionBox[RowBox[{RowBox[
                          {"Re", "[", "seed0", "]"}], "-", "center"}], 
                          "reScale"]}], "}"}], ",", RowBox[{"{", RowBox[
                          {"y", ",", FractionBox[RowBox[{"Im", "[", "seed0", 
                          "]"}], "imScale"]}], "}"}]}], "}"}], ",", RowBox[
                          {"WorkingPrecision", "\[Rule]", "wp"}], ",", 
                          RowBox[{"AccuracyGoal", "\[Rule]", "goal"}], ",", 
                          RowBox[{"PrecisionGoal", "\[Rule]", "goal"}], ",", 
                          RowBox[{"MaxIterations", "\[Rule]", "100"}]}], 
                        "]"}], "]"}], ",", "limit", ",", "$Failed"}], 
                  "]"}]}], ";", RowBox[{"seconds", "=", RowBox[
                 {RowBox[{"AbsoluteTime", "[", "]"}], "-", "start"}]}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"MatchQ", "[", 
                      RowBox[{"sol", ",", RowBox[{"{", RowBox[{"_Rule", 
                          ".."}], "}"}]}], "]"}]}], ",", RowBox[{"Return", 
                    "[", RowBox[{"Association", "[", RowBox[{RowBox[
                         {"\"Status\"", "\[Rule]", "\"RootFailed\""}], ",", 
                        RowBox[{"\"Depth\"", "\[Rule]", "depth"}], ",", 
                        RowBox[{"\"WorkingPrecision\"", "\[Rule]", "wp"}], 
